+        if wantsData {
+            guard let data = item[kSecValueData] else { return nil }
+            values[kSecValueData] = data
+        }
+        if wantsRef {
+            guard let reference = keyReference(item) else { return nil }
+            values[kSecValueRef] = reference
+        }
+        return values
+    }
