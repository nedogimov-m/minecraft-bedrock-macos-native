index 0000000..af643c6
--- /dev/null
+++ b/PlayTools/MysticRunes/PlayedAppleDBPersistentRef.swift
@@ -0,0 +1,79 @@
+//
+//  PlayedAppleDBPersistentRef.swift
+//  PlayTools
+//
+
+import Foundation
+import Security
+import SQLite3
+
+extension PlayKeychainDB {
+    func query(persistentRef: Data, attributes: NSDictionary) -> [NSMutableDictionary]? {
+        let tableNames: [String]
+        if let tableName = attributes[kSecClass] as? String {
+            guard PlayedAppleDBConstants.primaries[tableName as CFString] != nil else { return nil }
+            tableNames = [tableName]
+        } else {
+            tableNames = PlayedAppleDBConstants.primaries.keys.map { $0 as String }
+        }
+
+        var matches: [NSMutableDictionary] = []
+        guard usingDB({ sqlite3DB in
+            for tableName in tableNames {
+                var stmt: OpaquePointer?
+                let selectQuery = "SELECT * FROM \(tableName) WHERE \(kSecValuePersistentRef) = ? LIMIT 1"
+                guard sqlite3_prepare_v2(sqlite3DB, selectQuery, -1, &stmt, nil) == SQLITE_OK,
+                      let stmt = stmt else {
+                    sqlite3_finalize(stmt)
+                    return false
+                }
+                defer { sqlite3_finalize(stmt) }
+
+                guard encodeData(stmt: stmt, index: 1, value: persistentRef as CFData) else { return false }
+                let status = sqlite3_step(stmt)
+                if status == SQLITE_ROW {
+                    matches.append(decodeRow(stmt: stmt, tableName: tableName, attributes: attributes))
+                    return true
+                }
+                guard status == SQLITE_DONE else { return false }
+            }
+            return true
+        }) else { return nil }
+
+        return matches
+    }
+
+    func delete(persistentRef: Data, itemClass: String?) -> Bool {
+        let tableNames: [String]
+        if let itemClass = itemClass {
+            guard PlayedAppleDBConstants.primaries[itemClass as CFString] != nil else { return false }
+            tableNames = [itemClass]
+        } else {
+            tableNames = PlayedAppleDBConstants.primaries.keys.map { $0 as String }
+        }
+
+        var deleted = false
+        guard usingDB({ sqlite3DB in
+            for tableName in tableNames {
+                var stmt: OpaquePointer?
+                let deleteQuery = "DELETE FROM \(tableName) WHERE \(kSecValuePersistentRef) = ?"
+                guard sqlite3_prepare_v2(sqlite3DB, deleteQuery, -1, &stmt, nil) == SQLITE_OK,
+                      let stmt = stmt else {
+                    sqlite3_finalize(stmt)
+                    return false
+                }
+                defer { sqlite3_finalize(stmt) }
+
+                guard encodeData(stmt: stmt, index: 1, value: persistentRef as CFData),
+                      sqlite3_step(stmt) == SQLITE_DONE else { return false }
+                if sqlite3_changes(sqlite3DB) > 0 {
+                    deleted = true
+                    return true
+                }
+            }
+            return true
+        }) else { return false }
+
+        return deleted
+    }
+}
